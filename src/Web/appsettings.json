  "FrontendUrl:CustomerPortal": "https://uat-customer.hgidigital.com",
  "FrontendUrl:AgentPortal": "https://uat-agent.hgidigital.com",

  "Jwt:Issuer": "BeemaEdgeApi",
  "Jwt:Audience": "BeemaEdgeClient"
}
