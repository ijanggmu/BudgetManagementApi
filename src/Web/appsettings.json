{
  "AllowedHosts": "*",
  "AppSettings": {
    "EnableSwagger": true
  },
  "Tenancy": {
    "Strategy": "SharedTable",
    "SchemaPrefix": "tenant_"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "CORSUrls:0": "localhost",
