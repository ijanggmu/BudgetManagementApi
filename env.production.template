# BeemaEdge Production Environment Variables Template
# Copy this file to .env.production and update with your actual values
# DO NOT commit .env.production to version control

# ============================================================================
# PostgreSQL Database Configuration
# ============================================================================
POSTGRES_USER=beemaedge
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=beemaedge_db

POSTGRES_AUDIT_USER=beemaedge_audit
POSTGRES_AUDIT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_AUDIT_DB=beemaedge_audit_db

POSTGRES_HANGFIRE_USER=beemaedge_hangfire
POSTGRES_HANGFIRE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HANGFIRE_DB=beemaedge_hangfire_db

# ============================================================================
# Seq Logging Configuration
# ============================================================================
SEQ_ADMIN_USERNAME=admin
SEQ_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEQ_API_KEY=CHANGE_ME_GENERATE_API_KEY_FROM_SEQ_UI

# ============================================================================
# JWT Configuration
# ============================================================================
JWT_KEY=CHANGE_ME_GENERATE_64_BYTE_HEX_STRING
JWT_ISSUER=BeemaEdgeApi
JWT_AUDIENCE=BeemaEdgeClient
JWT_EXPIRES_IN_MINUTES=480
JWT_REFRESH_EXPIRES_IN_MINUTES=10080

# ============================================================================
# Hangfire Configuration
# ============================================================================
HANGFIRE_USERNAME=Hangfire-Admin
HANGFIRE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
HANGFIRE_ROUTE=/hangfire-admin-dashboard

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_URL_0=localhost
CORS_URL_1=https://yourdomain.com
CORS_URL_2=https://api.yourdomain.com

# ============================================================================
# Frontend URLs
# ============================================================================
FRONTEND_URL_CUSTOMER_PORTAL=https://customer.yourdomain.com
FRONTEND_URL_AGENT_PORTAL=https://agent.yourdomain.com

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_PER_HOUR=8000

# ============================================================================
# Cache Configuration
# ============================================================================
CACHE_ENABLED=true
CACHE_TYPE=InMemory

# ============================================================================
# MinIO/Object Storage (Optional)
# ============================================================================
MINIO_ENDPOINT=your-minio-endpoint.com
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=your-bucket-name



